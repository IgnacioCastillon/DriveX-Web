<!DOCTYPE html>
<html lang="es">
<head>
  <meta charset="utf-8">
  <meta name="viewport" content="width=device-width, initial-scale=1.0">
  <title>DriveX · Contact Form</title>
  <link rel="icon" type="image/png" href="/images/logo.png">
  <link rel="stylesheet" href="/stylesheets/base.css">
  <link rel="stylesheet" href="/stylesheets/header.css">

  <link rel="stylesheet" href="/stylesheets/contact.css">

</head>

<body class="dx-page">
  <div class="dx-page__wrap">

    <%- include("partials/header", { 
      user, 
      activePage: "contact", 
      showSearch: false
    }) %>

    <main class="dx-page__main">
      <section class="dx-contact glass-panel">
        <header class="dx-contact__header">
          <h1 class="dx-contact__title">Contact Us</h1>
          <p class="dx-contact__subtitle">Send us a message and we'll get back to you shortly.</p>
        </header>

        <form class="dx-contact__form" method="post" action="/contact">
          <div class="dx-grid">
            <div class="auth-field">
              <label for="name">Name</label>
              <input type="text" id="name" name="name" placeholder="Your full name" required>
            </div>

            <div class="auth-field">
              <label for="reason">Subject</label>
              <input type="text" id="reason" name="reason" placeholder="What is this about?" required>
            </div>
          </div>

          <% if (typeof user !== 'undefined' && user) { %>
            <input type="hidden" id="email" name="email" value="<%= user.email %>">
          <% } else { %>
            <div class="auth-field">
              <label for="email">Email</label>
              <input type="email" id="email" name="email" placeholder="your@email.com" required>
            </div>
          <% } %>

          <div class="auth-field">
            <label for="body">Message</label>
            <textarea id="body" name="body" placeholder="Write your message here..." rows="6" required></textarea>
          </div>

          <div class="dx-contact__actions">
            <a class="btn-premium" href="/" style="text-decoration:none;">← Return to Catalog</a>
            <button type="submit" class="btn-premium primary">Send Message</button>
          </div>

          <% if (typeof success !== 'undefined' && success) { %>
            <p class="dx-alert dx-alert--success"><%= success %></p>
          <% } %>

          <% if (typeof error !== 'undefined' && error) { %>
            <p class="dx-alert dx-alert--error"><%= error %></p>
          <% } %>
        </form>
      </section>
    </main>

    <footer class="dx-page__footer">
      <p>DriveX · Los Del Fondo Devs · Málaga, 2025.</p>
    </footer>

  </div>

  <script src="/js/header.js"></script>
</body>
</html>