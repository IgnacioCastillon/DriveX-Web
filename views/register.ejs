<!DOCTYPE html>
<html lang="es">

<head>
  <meta charset="UTF-8">
  <meta name="viewport" content="width=device-width, initial-scale=1.0">
  <title>DriveX · Create Account</title>
  <link rel="stylesheet" href="/stylesheets/base.css">
  <link rel="stylesheet" href="/stylesheets/login.css">
</head>

<body class="auth-body">

  <div class="auth-wrapper">
    <header class="auth-header">
      <a href="/" class="logo">
        <img src="/images/logo.png" alt="DriveX logo">
        <span>DriveX</span>
      </a>
    </header>

    <main class="auth-main">
      <section class="auth-card">
        <h1 class="auth-title">Create Account</h1>
        <p class="auth-subtitle">Join DriveX to explore our premium collection</p>

        <form class="auth-form" method="post" action="/register">
          <div class="auth-field">
            <label for="email">Email Address</label>
            <input type="email" id="email" name="email" placeholder="you@example.com" required>
          </div>

          <div class="auth-field">
            <label for="username">Username</label>
            <input type="text" id="username" name="username" placeholder="johndoe" required>
          </div>

          <div class="auth-field">
            <label for="password_hash">Password</label>
            <input type="password" id="password_hash" name="password_hash" placeholder="••••••••" required>
          </div>

          <div style="display: grid; grid-template-columns: 1fr 1fr; gap: 1rem;">
            <div class="auth-field">
              <label for="first_name">First Name</label>
              <input type="text" id="first_name" name="first_name" placeholder="John" required>
            </div>

            <div class="auth-field">
              <label for="last_name">Last Name</label>
              <input type="text" id="last_name" name="last_name" placeholder="Doe" required>
            </div>
          </div>

          <div class="auth-field">
            <label for="phone_number">Phone Number</label>
            <input type="text" id="phone_number" name="phone_number" placeholder="+34 600 000 000">
          </div>

          <button type="submit" class="btn-premium primary auth-button">
            Create Account
          </button>

          <p class="auth-extra">
            Already have an account?
            <a href="/login">Log in here</a>
          </p>
        </form>
      </section>
    </main>

    <footer class="auth-footer">
      <p>DriveX · Los Del Fondo Devs · Málaga, 2025.</p>
    </footer>
  </div>

</body>

</html>