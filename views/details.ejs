<!DOCTYPE html>
<html lang="es">

<head>
  <meta charset="UTF-8">
  <meta name="viewport" content="width=device-width, initial-scale=1.0">
  <title>DriveX · <%= vehicle.brand %> <%= vehicle.model %></title>
  <link rel="icon" type="image/png" href="/images/logo.png">
  <link rel="stylesheet" href="/stylesheets/base.css">
  <link rel="stylesheet" href="/stylesheets/details.css">
  <link rel="stylesheet" href="/stylesheets/header.css">
</head>

<body class="details-body">

  <div class="details-wrapper">

    <%- include("partials/header", { 
      user, 
      activePage: "",
      showSearch: false
    }) %>

    <main class="details-main">
      <section class="details-gallery">
        <% 
          const images = vehicle.images || []; 
          const mainImage = images.find(img => img.isMain) || images[0];
          const mainSrc = mainImage ? mainImage.imageUrl : "https://darkorchid-chicken-425842.hostingersite.com/images/vehicles/defecto.png";
        %>

        <div class="details-main-wrap">
          <% if (vehicle.offers === "Yes") { %>
            <div class="offer-badge-details">OFFER</div>
          <% } %>

          <img
            src="<%= mainSrc %>"
            alt="<%= vehicle.brand %> <%= vehicle.model %>"
            class="details-main-image"
            id="details-main-image"
          >
        </div>

        <div class="details-thumbs">
          <% images.forEach((img, index) => { %>
            <img 
              src="<%= img.imageUrl %>" 
              alt="<%= vehicle.brand %> <%= vehicle.model %>"
              data-src="<%= img.imageUrl %>" 
              class="<%= index === 0 ? 'active' : '' %>"
              onclick="document.getElementById('details-main-image').src = this.dataset.src; document.querySelectorAll('.details-thumbs img').forEach(i => i.classList.remove('active')); this.classList.add('active');"
            >
          <% }) %>
        </div>

        <% if (user && user.role === "Admin") { %>
          <div class="offer-switch-wrapper">
            <label class="offer-switch">
              <input 
                type="checkbox"
                class="offer-toggle"
                data-vehicle-id="<%= vehicle.id %>"
                <%= vehicle.offers === "Yes" ? "checked" : "" %>
              >
              <span class="slider"></span>
            </label>
            <span class="offer-label">
              <%= vehicle.offers === "Yes" ? "Offers Enabled" : "Offers Disabled" %>
            </span>
          </div>
        <% } %>
      </section>

      <section class="details-info">
        <div class="details-title">
          <p class="spec-label"><%= vehicle.vehicleType %></p>
          <h1><%= vehicle.brand %> <%= vehicle.model %></h1>
        </div>

        <div class="details-price"><%= vehicle.price %> €</div>

        <div class="spec-grid">
          <% if (vehicle.year) { %>
            <div class="spec-item">
              <span class="spec-label">Year</span>
              <span class="spec-value"><%= vehicle.year %></span>
            </div>
          <% } %>

          <% if (vehicle.mileage) { %>
            <div class="spec-item">
              <span class="spec-label">Mileage</span>
              <span class="spec-value"><%= vehicle.mileage %> miles</span>
            </div>
          <% } %>

          <% if (vehicle.fuelType) { %>
            <div class="spec-item">
              <span class="spec-label">Fuel Type</span>
              <span class="spec-value"><%= vehicle.fuelType %></span>
            </div>
          <% } %>

          <% if (vehicle.hp) { %>
            <div class="spec-item">
              <span class="spec-label">Horsepower</span>
              <span class="spec-value"><%= vehicle.hp %> HP</span>
            </div>
          <% } %>

          <% if (vehicle.doors) { %>
            <div class="spec-item">
              <span class="spec-label">Doors</span>
              <span class="spec-value"><%= vehicle.doors %></span>
            </div>
          <% } %>

          <% if (vehicle.reference) { %>
            <div class="spec-item">
              <span class="spec-label">Reference</span>
              <span class="spec-value">#<%= vehicle.reference %></span>
            </div>
          <% } %>
        </div>

        <% if (vehicle.description) { %>
          <div class="details-description">
            <h3>Description</h3>
            <p><%= vehicle.description %></p>
          </div>
        <% } %>

        <% if (vehicle.extras) { 
          const partes = vehicle.extras.split(",").map(p => p.trim()).sort();
        %>
          <div class="details-extras">
            <h3>Extras & Features</h3>
            <ul class="extras-list">
              <% partes.forEach(parte => { %>
                <li><%= parte %></li>
              <% }) %>
            </ul>
          </div>
        <% } %>

        <% if (user && user.role=="Admin") { %>
          <div class="admin-actions">
            <button id="editButton" class="btn-premium primary" style="flex: 1;">Edit Vehicle</button>

            <button id="deleteButton" data-vehicle-id="<%= vehicle.id %>" class="btn-premium btn-delete" style="flex: 1;">Delete Vehicle</button>

            <div id="editModal" class="dx-modal" aria-hidden="true">
              <div class="dx-modal-backdrop" data-close="1"></div>

              <div class="dx-modal-card glass-panel" role="dialog" aria-modal="true" aria-labelledby="dxEditTitle">
                <div class="dx-modal-head">
                  <div>
                    <h3 id="dxEditTitle" style="margin:0;">Edit vehicle</h3>
                    <p style="margin:.35rem 0 0; color: var(--text-muted);">Update the listing details and save changes.</p>
                  </div>

                  <button type="button" class="dx-modal-x btn-premium secondary" data-close="1" aria-label="Close">Close</button>
                </div>

                <div class="dx-modal-body">
                  <form id="editVehicleForm" class="dx-edit-form">
                    <input type="hidden" name="id" value="<%= vehicle.id %>">

                    <div class="dx-form-grid">
                      <div class="auth-field">
                        <label>Brand</label>
                        <select name="brand" id="editBrand" required></select>
                      </div>

                      <div class="auth-field">
                        <label>Model</label>
                        <input name="model" type="text" required>
                      </div>

                      <div class="auth-field">
                        <label>Vehicle Type</label>
                        <select name="vehicleType" required>
                          <option value="Sedan">Sedan</option>
                          <option value="Suv">Suv</option>
                          <option value="Hatchback">Hatchback</option>
                          <option value="Off-road / 4x4">Off-road / 4x4</option>
                          <option value="Van">Van</option>
                          <option value="MPV / Minivan">MPV / Minivan</option>
                          <option value="Pickup">Pickup</option>
                          <option value="Sport Car">Sport Car</option>
                          <option value="Hyper car">Hyper car</option>
                          <option value="Sport Bike">Sport Bike</option>
                          <option value="Custom">Custom</option>
                          <option value="Naked">Naked</option>
                          <option value="Enduro">Enduro</option>
                          <option value="Trial">Trial</option>
                          <option value="MotoCross">MotoCross</option>
                          <option value="Trail">Trail</option>
                          <option value="Touring">Touring</option>
                          <option value="Truck">Truck</option>
                        </select>
                      </div>

                      <div class="auth-field">
                        <label>Fuel Type</label>
                        <select name="fuelType" required>
                          <option value="Gasoline">Gasoline</option>
                          <option value="Diesel">Diesel</option>
                          <option value="Electric">Electric</option>
                          <option value="Hybrid">Hybrid</option>
                          <option value="Plug-in Hybrid">Plug-in Hybrid</option>
                          <option value="Other">Other</option>
                        </select>
                      </div>

                      <div class="auth-field">
                        <label>Year</label>
                        <input name="year" type="number" min="1900" max="2026" required>
                      </div>

                      <div class="auth-field">
                        <label>Price (€)</label>
                        <input name="price" type="number" min="0" required>
                      </div>

                      <div class="auth-field">
                        <label>Mileage (miles)</label>
                        <input name="mileage" type="number" min="0" required>
                      </div>

                      <div class="auth-field">
                        <label>Horsepower (HP)</label>
                        <input name="hp" type="number" min="0">
                      </div>

                      <div class="auth-field">
                        <label>Doors</label>
                        <input name="doors" type="number" min="0" max="5">
                      </div>

                      <div class="auth-field">
                        <label>Reference</label>
                        <input name="reference" type="text" placeholder="e.g. DX-2026-001">
                      </div>

                      <div class="auth-field" style="grid-column: 1 / -1;">
                        <label>Description</label>
                        <textarea name="description" rows="5" required></textarea>
                      </div>

                      <div class="auth-field" style="grid-column: 1 / -1;">
                        <label>Extras & Features</label>
                        <select name="extras" id="editExtras" multiple></select>
                        <small style="color: var(--text-muted);">Hold Ctrl (Win) or Cmd (Mac) to select multiple.</small>
                      </div>

                      <div class="auth-field" style="grid-column: 1 / -1; display:flex; align-items:center; gap:.75rem;">
                        <label style="margin:0;">Offer</label>
                        <select name="offers">
                          <option value="No">No</option>
                          <option value="Yes">Yes</option>
                        </select>
                      </div>
                    </div>

                    <div class="dx-modal-actions">
                      <div class="dx-edit-status" id="editStatus" style="color: var(--text-muted);"></div>
                      <div style="display:flex; gap:.75rem; justify-content:flex-end; flex-wrap:wrap;">
                        <button type="button" class="btn-premium secondary" data-close="1">Cancel</button>
                        <button type="submit" class="btn-premium primary" id="saveEditBtn">Save changes</button>
                      </div>
                    </div>
                  </form>
                </div>
              </div>
            </div>

            <script id="vehiclePayload" type="application/json"><%- JSON.stringify(vehicle) %></script>

            <div id="deleteModal" class="delete-modal">
              <div class="delete-modal-content">
                <h3>Confirm Deletion</h3>
                <p>This action cannot be undone.</p>
                <p>Type <strong>YES</strong> to confirm:</p>

                <input type="text" id="confirmInput" placeholder="Type YES">

                <div class="delete-actions">
                  <button id="cancelDelete" class="btn-premium secondary">Cancel</button>
                  <button id="confirmDelete" class="btn-premium btn-delete">Delete</button>
                </div>
              </div>
            </div>
          </div>
        <% } else { %>
          <div class="user-actions">
            <button class="btn-premium primary" style="width: 100%;" onclick="window.location.href='/contact'">Request Information</button>
          </div>
        <% } %>

      </section>
    </main>

    <footer class="home-footer">
      <p>DriveX is a creation of Los Del Fondo Devs. All rights reserved. Malaga, 2025.</p>
    </footer>
  </div>

  <script src="/js/header.js"></script>
  <script src="/js/details.js"></script>
</body>

</html>