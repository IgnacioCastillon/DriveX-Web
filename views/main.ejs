<!DOCTYPE html>
<html lang="es">

<head>
  <meta charset="utf-8">
  <meta name="viewport" content="width=device-width, initial-scale=1.0">
  <title>DriveX · Catálogo</title>
  <link rel="stylesheet" href="/stylesheets/base.css">
  <link rel="stylesheet" href="/stylesheets/main.css">
</head>

<body class="home-body">
  <div class="home-wrapper">

    <header class="main-header glass-panel">
      <div class="header-container">
        <div class="header-left">
          <a href="/" class="logo">
            <img src="/images/logo.png" alt="DriveX logo">
            <span>DriveX</span>
          </a>
        </div>

        <div class="header-center">
          <nav class="main-nav">
            <a href="/" id="home" class="nav-link active">Home</a>
            <a href="/aboutUs" id="aboutUs" class="nav-link">About Us</a>
            <a href="/contact" id="contact" class="nav-link">Contact</a>
            <% if (user && user.role=="Admin" ){ %>
              <a href="/users" class="nav-link admin-link">Admin</a>
            <% } %>
          </nav>
        </div>

        <div class="header-right">
          <div class="search-wrapper">
            <form method="get" action="/">
              <input type="search" name="search" placeholder="Search vehicles..."
                value="<%= typeof search !== 'undefined' ? search : '' %>" class="search-input">
            </form>
          </div>

          <a href="/favourites" class="nav-icon-link" title="Favourites">
            <svg xmlns="http://www.w3.org/2000/svg" width="20" height="20" fill="currentColor" viewBox="0 0 24 24">
              <path
                d="M12 .587l3.668 7.568L24 9.748l-6 5.848L19.335 24 12 19.897 4.665 24 6 15.596 0 9.748l8.332-1.593z" />
            </svg>
          </a>

          <div class="auth-buttons">
            <% if (!user) { %>
              <a href="/login" class="btn-premium primary">Log in</a>
            <% } else { %>
              <div class="user-profile">
                <span class="user-name"><%= user.name %></span>
                <a href="/logout" class="btn-premium secondary">Sign out</a>
              </div>
            <% } %>
          </div>
        </div>
      </div>
    </header>

    <main class="home-main">
      <section class="hero-section">
        <div id="backgroundImageContainer">
          <img id="backgroundImage" src="/images/concesionario.jpg" alt="Background image">
          <div class="hero-overlay">
            <h1>Find Your Dream Vehicle</h1>
            <p>Explore our premium collection of cars, bikes, and more.</p>
            <nav class="hero-nav">
              <a href="/?vehicleType=Sedan,Suv,Hatchback,Off-road / 4x4,Van,MPV,Pickup,Sport Car,Hyper Car"
                class="active">Cars</a>
              <a href="/?vehicleType=Sport Bike,Custom,Naked,Enduro,Trial,MotoCross,Trail,Touring"
                class="active">Bikes</a>
              <a href="#" class="active">Trucks</a>
              <a href="#" class="offers">Offers</a>
            </nav>
          </div>
        </div>
      </section>

      <main class="home-main">
        <div class="section-header">
          <h2>
            <%= (typeof isFavouritesPage !== 'undefined' && isFavouritesPage) ? 'Your Favourites' : 'Latest Arrivals' %>
          </h2>
          <% if (user && user.role=="Admin" ) { %>
            <a class="btn-premium primary" href="/add">Add Vehicle</a>
          <% } %>
        </div>

        <section class="vehicle-grid" id="vehicle-grid">
          <% if (Array.isArray(vehicles) && vehicles.length > 0) { %>

            <% 
              // ✅ ROBUSTO: compara SIEMPRE como string
              const favIds = Array.isArray(favoriteIds) ? favoriteIds.map(String) : [];
            %>

            <% vehicles.forEach(v => { %>
              <article class="vehicle-card">
                <% if (user) { %>
                  <% const isFavorite = favIds.includes(String(v.id)); %>

                  <button
                    class="fav-btn <%= isFavorite ? 'active' : '' %>"
                    type="button"
                    data-vehicle-id="<%= v.id %>"
                    aria-label="<%= isFavorite ? 'Remove from favourites' : 'Add to favourites' %>"
                    title="<%= isFavorite ? 'Remove from favourites' : 'Add to favourites' %>"
                  >
                    <% if (isFavorite) { %>
                      <svg class="fav-icon" xmlns="http://www.w3.org/2000/svg" viewBox="0 0 24 24" aria-hidden="true">
                        <path d="M12 .587l3.668 7.568L24 9.748l-6 5.848L19.335 24 12 19.897 4.665 24 6 15.596 0 9.748l8.332-1.593z"/>
                      </svg>
                    <% } else { %>
                      <svg class="fav-icon" xmlns="http://www.w3.org/2000/svg" viewBox="0 0 24 24" aria-hidden="true">
                        <path d="M12 17.75l-6.172 3.245 1.18-6.875L2.01 9.255l6.902-1.003L12 2l3.088 6.252 6.902 1.003-4.998 4.865 1.18 6.875L12 17.75z"
                              fill="none" stroke="currentColor" stroke-width="1.8" stroke-linejoin="round"/>
                      </svg>
                    <% } %>
                  </button>
                <% } %>

                <a href="/vehicles/<%= v.id %>" class="vehicle-link">
                  <% const images = v.images || []; %>
                  <% const mainImage = images.find(img => img.isMain) || images[0]; %>
                  <% const mainSrc = mainImage ? mainImage.imageUrl : "https://darkorchid-chicken-425842.hostingersite.com/images/vehicles/defecto.png"; %>

                  <div class="vehicle-main-image">
                    <img src="<%= mainSrc %>" alt="<%= v.brand %> <%= v.model %>">
                  </div>

                  <div class="vehicle-info">
                    <h3><%= v.brand %> <%= v.model %></h3>
                    <p><%= v.vehicleType %></p>
                    <br>
                    <p>
                      <%= v.price %> € · <%= v.mileage %> miles
                      <% if (v.year) { %> · <%= v.year %><% } %>
                      <% if (v.fuelType || v.fuel_type) { %> · <%= v.fuelType || v.fuel_type %><% } %>
                    </p>
                  </div>
                </a>
              </article>
            <% }) %>

          <% } else { %>
            <p class="empty-message">
              <%= (typeof isFavouritesPage !== 'undefined' && isFavouritesPage)
                  ? 'No tienes vehículos en favoritos.'
                  : 'No hay vehículos disponibles.' %>
            </p>
          <% } %>
        </section>

        <div class="pagination">
          <% if (currentPage > 1) { %>
            <a class="arrow page-link"
              href="/?page=<%= currentPage - 1 %>&search=<%= encodeURIComponent(search) %>">←</a>
          <% } else { %>
            <span class="arrow disabled">←</span>
          <% } %>

          <span class="current-page"><%= currentPage %></span>

          <% if (currentPage < totalPages) { %>
            <a class="arrow page-link"
              href="/?page=<%= currentPage + 1 %>&search=<%= encodeURIComponent(search) %>">→</a>
          <% } else { %>
            <span class="arrow disabled">→</span>
          <% } %>
        </div>
      </main>

      <footer class="home-footer">
        <p>DriveX is a creation of Los Del Fondo Devs. All rights reserved. Malaga, 2025.</p>
      </footer>

  </div>

  <div id="overlay"></div>

  <div id="contactMessage">
    <h2>Welcome to DriveX</h2>
    <p>Please, log in to access all the functions.</p>
    <a href="/login" class="btn-login-oculto">Log in</a>
    <button id="closeMessage">Close</button>
  </div>

  <script src="/js/main.js"></script>

  <!-- ✅ Estado global de favoritos (para que NO "desaparezca" al repintar/paginar por AJAX) -->
  <script>
    const IS_FAV_PAGE = <%= (typeof isFavouritesPage !== 'undefined' && isFavouritesPage) ? 'true' : 'false' %>;
    window.__FAV_IDS__ = <%- JSON.stringify(Array.isArray(favoriteIds) ? favoriteIds.map(String) : []) %>;
  </script>

  <script>
    const filledStar = `
      <svg class="fav-icon" xmlns="http://www.w3.org/2000/svg" viewBox="0 0 24 24" aria-hidden="true">
        <path d="M12 .587l3.668 7.568L24 9.748l-6 5.848L19.335 24 12 19.897 4.665 24 6 15.596 0 9.748l8.332-1.593z"/>
      </svg>
    `;

    const outlineStar = `
      <svg class="fav-icon" xmlns="http://www.w3.org/2000/svg" viewBox="0 0 24 24" aria-hidden="true">
        <path d="M12 17.75l-6.172 3.245 1.18-6.875L2.01 9.255l6.902-1.003L12 2l3.088 6.252 6.902 1.003-4.998 4.865 1.18 6.875L12 17.75z"
              fill="none" stroke="currentColor" stroke-width="1.8" stroke-linejoin="round"/>
      </svg>
    `;

    function setFavUI(btn, isFav) {
      if (isFav) {
        btn.classList.add("active");
        btn.innerHTML = filledStar;
        btn.title = "Remove from favourites";
        btn.setAttribute("aria-label", "Remove from favourites");
      } else {
        btn.classList.remove("active");
        btn.innerHTML = outlineStar;
        btn.title = "Add to favourites";
        btn.setAttribute("aria-label", "Add to favourites");
      }
    }

    function addFavId(id) {
      const sid = String(id);
      if (!window.__FAV_IDS__.includes(sid)) window.__FAV_IDS__.push(sid);
    }

    function removeFavId(id) {
      const sid = String(id);
      window.__FAV_IDS__ = window.__FAV_IDS__.filter(x => x !== sid);
    }

    document.addEventListener("click", async (e) => {
      const btn = e.target.closest(".fav-btn");
      if (!btn) return;

      e.preventDefault();
      e.stopPropagation();

      if (btn.dataset.loading === "1") return;
      btn.dataset.loading = "1";

      const vehicleId = btn.dataset.vehicleId;

      const wasFav = btn.classList.contains("active");

      // ✅ Optimista
      setFavUI(btn, !wasFav);
      if (!wasFav) addFavId(vehicleId);
      else removeFavId(vehicleId);

      try {
        const res = await fetch(`/favourites/${vehicleId}/toggle`, { method: "POST" });
        const text = await res.text();
        if (!res.ok) throw new Error(text || "Request failed");

        const data = JSON.parse(text);
        const nowFav = !!data.favorite;

        setFavUI(btn, nowFav);
        if (nowFav) addFavId(vehicleId);
        else removeFavId(vehicleId);

        // ✅ Solo si estás en /favourites y lo quitas, quita la card
        if (IS_FAV_PAGE && nowFav === false) {
          const card = btn.closest(".vehicle-card");
          if (card) card.remove();

          const grid = document.getElementById("vehicle-grid");
          const remainingCards = grid ? grid.querySelectorAll(".vehicle-card").length : 0;
          if (grid && remainingCards === 0) {
            grid.innerHTML = `<p class="empty-message">No tienes vehículos en favoritos.</p>`;
          }
        }
      } catch (err) {
        console.error("FAV ERROR:", err);

        // ❌ rollback
        setFavUI(btn, wasFav);
        if (wasFav) addFavId(vehicleId);
        else removeFavId(vehicleId);

        alert("No se pudo actualizar fav (mira consola F12)");
      } finally {
        btn.dataset.loading = "0";
      }
    });
  </script>
</body>

</html>