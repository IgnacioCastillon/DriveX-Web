        <option value="Ferrari" <%= filters?.brand === "Ferrari" ? "selected" : "" %>>Ferrari</option>
        <option value="Fiat" <%= filters?.brand === "Fiat" ? "selected" : "" %>>Fiat</option>
        <option value="Ford" <%= filters?.brand === "Ford" ? "selected" : "" %>>Ford</option>
        <option value="Honda" <%= filters?.brand === "Honda" ? "selected" : "" %>>Honda</option>
        <option value="Hyundai" <%= filters?.brand === "Hyundai" ? "selected" : "" %>>Hyundai</option>
        <option value="Jaguar" <%= filters?.brand === "Jaguar" ? "selected" : "" %>>Jaguar</option>
        <option value="Jeep" <%= filters?.brand === "Jeep" ? "selected" : "" %>>Jeep</option>
        <option value="Kawasaki" <%= filters?.brand === "Kawasaki" ? "selected" : "" %>>Kawasaki</option>
        <option value="Kia" <%= filters?.brand === "Kia" ? "selected" : "" %>>Kia</option>
        <option value="KTM" <%= filters?.brand === "KTM" ? "selected" : "" %>>KTM</option>
