<!DOCTYPE html>
<html lang="es">

<head>
  <meta charset="utf-8">
  <meta name="viewport" content="width=device-width, initial-scale=1.0">
  <title>DriveX · Catálogo</title>
  <link rel="icon" type="image/png" href="/images/logo.png">
  <link rel="stylesheet" href="/stylesheets/base.css">
  <link rel="stylesheet" href="/stylesheets/main.css">
  <link rel="stylesheet" href="/stylesheets/header.css">
</head>

<body class="home-body">
  <div class="home-wrapper">

    <%- include("partials/header", { 
      user, 
      activePage: "home", 
      showSearch: true,
      searchAction: "/",
      searchPlaceholder: "Search vehicles...",
      search
    }) %>

    <main class="home-main">
      <section class="hero-section">
        <div id="backgroundImageContainer">
          <img id="backgroundImage" src="/images/concesionario.jpg" alt="Background image">
          <div class="hero-overlay">
            <h1>Find Your Dream Vehicle</h1>
            <p>Explore our premium collection of cars, bikes, and more.</p>
            <nav class="hero-nav">
              <a href="/?vehicleType=Sedan,Suv,Hatchback,Off-road%20%2F%204x4,Van,MPV%20%2F%20Minivan,Pickup,Sport%20Car,Hyper%20car" class="active">Cars</a>
              <a href="/?vehicleType=Sport%20Bike,Custom,Naked,Enduro,Trial,MotoCross,Trail,Touring" class="active">Bikes</a>
              <a href="/?vehicleType=Truck" class="active">Trucks</a>
              <a href="/offers" class="offers">Offers</a>
            </nav>
          </div>
        </div>
      </section>

      <div class="section-header">
        <h2>
          <% if (search && search.trim() !== "") { %>
            Results for "<%= search %>"
          <% } else { %>
            Latest Arrivals
          <% } %>
        </h2>
      </div>

      <% 
        const exSel = new Set([].concat(filters?.extras || []).map(String));
        const currentFilters = filters || {};
      %>

      <details class="glass-panel dx-admin-form dx-filters-collapsible" <%= (baseQuery && baseQuery.trim() !== "") ? "open" : "" %>>
        <summary class="dx-admin-summary">
          <div class="dx-admin-summaryText">
            <span class="dx-admin-title">Filters</span>
            <span class="dx-admin-subtitle">Refine your search</span>
          </div>
          <span class="btn-premium primary dx-admin-open" style="pointer-events:none;">Open</span>
        </summary>
      
        <div class="dx-admin-sep"></div>
      
        <form id="dxFilters" class="dx-filters" method="get" action="/">
          <input type="hidden" name="search" value="<%= search || '' %>">
      
          <div class="dx-filters-grid">
            <div class="auth-field">
              <label>Brand</label>
              <select name="brand">
                <option value="">Any</option>
                <option value="Abarth" <%= currentFilters.brand === "Abarth" ? "selected" : "" %>>Abarth</option>
                <option value="Alfa Romeo" <%= currentFilters.brand === "Alfa Romeo" ? "selected" : "" %>>Alfa Romeo</option>
                <option value="Aprilia" <%= currentFilters.brand === "Aprilia" ? "selected" : "" %>>Aprilia</option>
                <option value="Aston Martin" <%= currentFilters.brand === "Aston Martin" ? "selected" : "" %>>Aston Martin</option>
                <option value="Audi" <%= currentFilters.brand === "Audi" ? "selected" : "" %>>Audi</option>
                <option value="Bentley" <%= currentFilters.brand === "Bentley" ? "selected" : "" %>>Bentley</option>
                <option value="BMW" <%= currentFilters.brand === "BMW" ? "selected" : "" %>>BMW</option>
                <option value="Bugatti" <%= currentFilters.brand === "Bugatti" ? "selected" : "" %>>Bugatti</option>
                <option value="Cadillac" <%= currentFilters.brand === "Cadillac" ? "selected" : "" %>>Cadillac</option>
                <option value="Chevrolet" <%= currentFilters.brand === "Chevrolet" ? "selected" : "" %>>Chevrolet</option>
                <option value="Citroen" <%= currentFilters.brand === "Citroen" ? "selected" : "" %>>Citroen</option>
                <option value="Cupra" <%= currentFilters.brand === "Cupra" ? "selected" : "" %>>Cupra</option>
                <option value="Dacia" <%= currentFilters.brand === "Dacia" ? "selected" : "" %>>Dacia</option>
                <option value="Dodge" <%= currentFilters.brand === "Dodge" ? "selected" : "" %>>Dodge</option>
                <option value="Ducati" <%= currentFilters.brand === "Ducati" ? "selected" : "" %>>Ducati</option>
                <option value="Ferrari" <%= currentFilters.brand === "Ferrari" ? "selected" : "" %>>Ferrari</option>
                <option value="Fiat" <%= currentFilters.brand === "Fiat" ? "selected" : "" %>>Fiat</option>
                <option value="Ford" <%= currentFilters.brand === "Ford" ? "selected" : "" %>>Ford</option>
                <option value="Honda" <%= currentFilters.brand === "Honda" ? "selected" : "" %>>Honda</option>
                <option value="Hyundai" <%= currentFilters.brand === "Hyundai" ? "selected" : "" %>>Hyundai</option>
                <option value="Jaguar" <%= currentFilters.brand === "Jaguar" ? "selected" : "" %>>Jaguar</option>
                <option value="Jeep" <%= currentFilters.brand === "Jeep" ? "selected" : "" %>>Jeep</option>
                <option value="Kawasaki" <%= currentFilters.brand === "Kawasaki" ? "selected" : "" %>>Kawasaki</option>
                <option value="Kia" <%= currentFilters.brand === "Kia" ? "selected" : "" %>>Kia</option>
                <option value="KTM" <%= currentFilters.brand === "KTM" ? "selected" : "" %>>KTM</option>
                <option value="Lamborghini" <%= currentFilters.brand === "Lamborghini" ? "selected" : "" %>>Lamborghini</option>
                <option value="Land Rover" <%= currentFilters.brand === "Land Rover" ? "selected" : "" %>>Land Rover</option>
                <option value="Lexus" <%= currentFilters.brand === "Lexus" ? "selected" : "" %>>Lexus</option>
                <option value="Maserati" <%= currentFilters.brand === "Maserati" ? "selected" : "" %>>Maserati</option>
                <option value="Mazda" <%= currentFilters.brand === "Mazda" ? "selected" : "" %>>Mazda</option>
                <option value="McLaren" <%= currentFilters.brand === "McLaren" ? "selected" : "" %>>McLaren</option>
                <option value="Mercedes-Benz" <%= currentFilters.brand === "Mercedes-Benz" ? "selected" : "" %>>Mercedes-Benz</option>
                <option value="Mini" <%= currentFilters.brand === "Mini" ? "selected" : "" %>>Mini</option>
                <option value="Mitsubishi" <%= currentFilters.brand === "Mitsubishi" ? "selected" : "" %>>Mitsubishi</option>
                <option value="Nissan" <%= currentFilters.brand === "Nissan" ? "selected" : "" %>>Nissan</option>
                <option value="Opel" <%= currentFilters.brand === "Opel" ? "selected" : "" %>>Opel</option>
                <option value="Peugeot" <%= currentFilters.brand === "Peugeot" ? "selected" : "" %>>Peugeot</option>
                <option value="Porsche" <%= currentFilters.brand === "Porsche" ? "selected" : "" %>>Porsche</option>
                <option value="Renault" <%= currentFilters.brand === "Renault" ? "selected" : "" %>>Renault</option>
                <option value="Seat" <%= currentFilters.brand === "Seat" ? "selected" : "" %>>Seat</option>
                <option value="Skoda" <%= currentFilters.brand === "Skoda" ? "selected" : "" %>>Skoda</option>
                <option value="Subaru" <%= currentFilters.brand === "Subaru" ? "selected" : "" %>>Subaru</option>
                <option value="Suzuki" <%= currentFilters.brand === "Suzuki" ? "selected" : "" %>>Suzuki</option>
                <option value="Tesla" <%= currentFilters.brand === "Tesla" ? "selected" : "" %>>Tesla</option>
                <option value="Toyota" <%= currentFilters.brand === "Toyota" ? "selected" : "" %>>Toyota</option>
                <option value="Triumph" <%= currentFilters.brand === "Triumph" ? "selected" : "" %>>Triumph</option>
                <option value="Volkswagen" <%= currentFilters.brand === "Volkswagen" ? "selected" : "" %>>Volkswagen</option>
                <option value="Volvo" <%= currentFilters.brand === "Volvo" ? "selected" : "" %>>Volvo</option>
                <option value="Yamaha" <%= currentFilters.brand === "Yamaha" ? "selected" : "" %>>Yamaha</option>
              </select>
            </div>
      
            <div class="auth-field">
              <label>Type</label>
              <select name="vehicleType">
                <option value="">Any</option>
                <optgroup label="Cars">
                  <option value="Sedan" <%= currentFilters.vehicleType === "Sedan" ? "selected" : "" %>>Sedan</option>
                  <option value="Suv" <%= currentFilters.vehicleType === "Suv" ? "selected" : "" %>>Suv</option>
                  <option value="Hatchback" <%= currentFilters.vehicleType === "Hatchback" ? "selected" : "" %>>Hatchback</option>
                  <option value="Off-road / 4x4" <%= currentFilters.vehicleType === "Off-road / 4x4" ? "selected" : "" %>>Off-road / 4x4</option>
                  <option value="Van" <%= currentFilters.vehicleType === "Van" ? "selected" : "" %>>Van</option>
                  <option value="MPV / Minivan" <%= currentFilters.vehicleType === "MPV / Minivan" ? "selected" : "" %>>MPV / Minivan</option>
                  <option value="Pickup" <%= currentFilters.vehicleType === "Pickup" ? "selected" : "" %>>Pickup</option>
                  <option value="Sport Car" <%= currentFilters.vehicleType === "Sport Car" ? "selected" : "" %>>Sport Car</option>
                  <option value="Hyper car" <%= currentFilters.vehicleType === "Hyper car" ? "selected" : "" %>>Hyper car</option>
                </optgroup>
                <optgroup label="Bikes">
                  <option value="Sport Bike" <%= currentFilters.vehicleType === "Sport Bike" ? "selected" : "" %>>Sport Bike</option>
                  <option value="Custom" <%= currentFilters.vehicleType === "Custom" ? "selected" : "" %>>Custom</option>
                  <option value="Naked" <%= currentFilters.vehicleType === "Naked" ? "selected" : "" %>>Naked</option>
                  <option value="Enduro" <%= currentFilters.vehicleType === "Enduro" ? "selected" : "" %>>Enduro</option>
                  <option value="Trial" <%= currentFilters.vehicleType === "Trial" ? "selected" : "" %>>Trial</option>
                  <option value="MotoCross" <%= currentFilters.vehicleType === "MotoCross" ? "selected" : "" %>>MotoCross</option>
                  <option value="Trail" <%= currentFilters.vehicleType === "Trail" ? "selected" : "" %>>Trail</option>
                  <option value="Touring" <%= currentFilters.vehicleType === "Touring" ? "selected" : "" %>>Touring</option>
                </optgroup>
                <optgroup label="Trucks">
                  <option value="Truck" <%= currentFilters.vehicleType === "Truck" ? "selected" : "" %>>Truck</option>
                </optgroup>
              </select>
            </div>
      
            <div class="auth-field">
              <label>Fuel</label>
              <select name="fuelType">
                <option value="">Any</option>
                <option value="Gasoline" <%= currentFilters.fuelType === "Gasoline" ? "selected" : "" %>>Gasoline</option>
                <option value="Diesel" <%= currentFilters.fuelType === "Diesel" ? "selected" : "" %>>Diesel</option>
                <option value="Electric" <%= currentFilters.fuelType === "Electric" ? "selected" : "" %>>Electric</option>
                <option value="Hybrid" <%= currentFilters.fuelType === "Hybrid" ? "selected" : "" %>>Hybrid</option>
                <option value="Plug-in Hybrid" <%= currentFilters.fuelType === "Plug-in Hybrid" ? "selected" : "" %>>Plug-in Hybrid</option>
                <option value="Other" <%= currentFilters.fuelType === "Other" ? "selected" : "" %>>Other</option>
              </select>
            </div>
      
            <div class="auth-field">
              <label>Min Year</label>
              <input type="number" name="minYear" min="1900" max="2026" value="<%= currentFilters.minYear || '' %>">
            </div>
      
            <div class="auth-field">
              <label>Max Year</label>
              <input type="number" name="maxYear" min="1900" max="2026" value="<%= currentFilters.maxYear || '' %>">
            </div>
      
            <div class="auth-field">
              <label>Offers</label>
              <select name="offers">
                <option value="">All</option>
                <option value="Yes" <%= currentFilters.offers === "Yes" ? "selected" : "" %>>Only offers</option>
              </select>
            </div>
      
            <div class="auth-field">
              <label>Min Price (€)</label>
              <input type="number" name="minPrice" min="0" value="<%= currentFilters.minPrice || '' %>">
            </div>
      
            <div class="auth-field">
              <label>Max Price (€)</label>
              <input type="number" name="maxPrice" min="0" value="<%= currentFilters.maxPrice || '' %>">
            </div>
      
            <div class="auth-field">
              <label>Max Mileage</label>
              <input type="number" name="maxMileage" min="0" value="<%= currentFilters.maxMileage || '' %>">
            </div>
      
            <div class="auth-field dx-span-2">
              <label>Extras</label>
              <select name="extras" multiple size="4">
                <option value="ABS" <%= exSel.has("ABS") ? "selected" : "" %>>ABS</option>
                <option value="Airbags" <%= exSel.has("Airbags") ? "selected" : "" %>>Airbags</option>
                <option value="Bluetooth" <%= exSel.has("Bluetooth") ? "selected" : "" %>>Bluetooth</option>
                <option value="Cruise Control" <%= exSel.has("Cruise Control") ? "selected" : "" %>>Cruise Control</option>
                <option value="Navigation System" <%= exSel.has("Navigation System") ? "selected" : "" %>>Navigation System</option>
                <option value="Parking Sensors" <%= exSel.has("Parking Sensors") ? "selected" : "" %>>Parking Sensors</option>
                <option value="Rear Camera" <%= exSel.has("Rear Camera") ? "selected" : "" %>>Rear Camera</option>
                <option value="Sunroof" <%= exSel.has("Sunroof") ? "selected" : "" %>>Sunroof</option>
                <option value="Leather Seats" <%= exSel.has("Leather Seats") ? "selected" : "" %>>Leather Seats</option>
                <option value="Android Auto" <%= exSel.has("Android Auto") ? "selected" : "" %>>Android Auto</option>
                <option value="Apple CarPlay" <%= exSel.has("Apple CarPlay") ? "selected" : "" %>>Apple CarPlay</option>
                <option value="Premium Sound System" <%= exSel.has("Premium Sound System") ? "selected" : "" %>>Premium Sound System</option>
              </select>
              <small style="color: var(--text-muted);">Hold Ctrl (Win) or Cmd (Mac) to select multiple.</small>
            </div>
      
            <div class="auth-field">
              <label>Sort</label>
              <select name="sort">
                <option value="">Newest</option>
                <option value="priceAsc" <%= currentFilters.sort === "priceAsc" ? "selected" : "" %>>Price ↑</option>
                <option value="priceDesc" <%= currentFilters.sort === "priceDesc" ? "selected" : "" %>>Price ↓</option>
                <option value="yearDesc" <%= currentFilters.sort === "yearDesc" ? "selected" : "" %>>Year ↓</option>
                <option value="mileageAsc" <%= currentFilters.sort === "mileageAsc" ? "selected" : "" %>>Mileage ↑</option>
              </select>
            </div>
          </div>
      
          <div class="dx-filter-actions">
            <a class="btn-premium" href="/" style="text-decoration:none;">Clear</a>
            <button type="submit" class="btn-premium primary">Apply filters</button>
          </div>
        </form>
      </details>

      <% if (user && user.role === "Admin") { %>
        <details class="glass-panel dx-admin-form">
          <summary class="dx-admin-summary">
            <div class="dx-admin-summaryText">
              <span class="dx-admin-title">Add New Vehicle</span>
              <span class="dx-admin-subtitle">Only visible for Admins</span>
            </div>
            <span class="btn-premium primary dx-admin-open" style="pointer-events:none;">Open</span>
          </summary>

          <div class="dx-admin-sep"></div>

          <form method="post" action="/addVehicle" enctype="multipart/form-data" class="dx-add-form">
            <div class="dx-add-col">
              <div class="auth-field">
                <label for="brand">Brand</label>
                <select id="brand" name="brand" required>
                  <option value="" selected disabled>- Select a brand -</option>
                </select>
              </div>

              <div class="auth-field">
                <label for="model">Model</label>
                <input type="text" id="model" name="model" placeholder="e.g. Model S" required>
              </div>

              <div class="auth-field">
                <label for="vehicle_type">Vehicle Type</label>
                <select id="vehicle_type" name="vehicle_type" required>
                  <option value="" disabled selected> - Select Type - </option>
                  <optgroup label="Cars">
                    <option value="Sedan">Sedan</option>
                    <option value="Suv">Suv</option>
                    <option value="Hatchback">Hatchback</option>
                    <option value="Off-road / 4x4">Off-road / 4x4</option>
                    <option value="Van">Van</option>
                    <option value="MPV / Minivan">MPV / Minivan</option>
                    <option value="Pickup">Pickup</option>
                    <option value="Sport Car">Sport Car</option>
                    <option value="Hyper car">Hyper car</option>
                  </optgroup>
                  <optgroup label="Bikes">
                    <option value="Sport Bike">Sport Bike</option>
                    <option value="Custom">Custom</option>
                    <option value="Naked">Naked</option>
                    <option value="Enduro">Enduro</option>
                    <option value="Trial">Trial</option>
                    <option value="MotoCross">MotoCross</option>
                    <option value="Trail">Trail</option>
                    <option value="Touring">Touring</option>
                  </optgroup>
                  <optgroup label="Trucks">
                    <option value="Truck">Truck</option>
                  </optgroup>
                </select>
              </div>

              <div class="dx-two">
                <div class="auth-field">
                  <label for="year">Year</label>
                  <input type="number" id="year" name="year" min="1900" max="2026" placeholder="2024" required>
                </div>
                <div class="auth-field">
                  <label for="price">Price (€)</label>
                  <input type="number" id="price" name="price" min="0" placeholder="50000" required>
                </div>
              </div>

              <div class="auth-field">
                <label for="description">Description</label>
                <textarea id="description" name="description" placeholder="Describe the vehicle..." rows="5" required></textarea>
              </div>

              <div class="auth-field">
                <label for="photos">Vehicle Photos</label>
                <input type="file" id="photos" name="photos" multiple accept="image/*">
                <small style="color: var(--text-muted);">Select up to 15 high-quality images.</small>
              </div>
            </div>

            <div class="dx-add-col">
              <div class="dx-two">
                <div class="auth-field">
                  <label for="mileage">Mileage (miles)</label>
                  <input type="number" id="mileage" name="mileage" min="0" placeholder="0" required>
                </div>
                <div class="auth-field">
                  <label for="doors">Doors</label>
                  <input type="number" id="doors" name="doors" min="0" max="5" value="4" required>
                </div>
              </div>

              <div class="dx-two">
                <div class="auth-field">
                  <label for="hp">Horsepower (HP)</label>
                  <input type="number" id="hp" name="hp" min="1" placeholder="150" required>
                </div>
                <div class="auth-field">
                  <label for="fuel_type">Fuel Type</label>
                  <select id="fuel_type" name="fuel_type" required>
                    <option value="" disabled selected> - Fuel - </option>
                    <option value="Gasoline">Gasoline</option>
                    <option value="Diesel">Diesel</option>
                    <option value="Electric">Electric</option>
                    <option value="Hybrid">Hybrid</option>
                    <option value="Plug-in Hybrid">Plug-in Hybrid</option>
                    <option value="Other">Other</option>
                  </select>
                </div>
              </div>

              <div class="dx-two">
                <div class="auth-field">
                  <label for="autonomy">Range (miles)</label>
                  <input type="number" id="autonomy" name="autonomy" min="1" placeholder="400" required>
                </div>
                <div class="auth-field">
                  <label for="average_consumption">Consumption (L/100m)</label>
                  <input type="number" id="average_consumption" name="average_consumption" min="0" step="0.1" placeholder="6.5" required>
                </div>
              </div>

              <div class="auth-field">
                <label for="extras">Extras & Features</label>
                <select id="extras" name="extras" multiple>
                  <option value="ABS">ABS</option>
                  <option value="Airbags">Airbags</option>
                  <option value="Automatic Climate Control">Automatic Climate Control</option>
                  <option value="Bluetooth">Bluetooth</option>
                  <option value="Cruise Control">Cruise Control</option>
                  <option value="Navigation System">Navigation System</option>
                  <option value="Parking Sensors">Parking Sensors</option>
                  <option value="Rear Camera">Rear Camera</option>
                  <option value="360 Camera">360 Camera</option>
                  <option value="Sunroof">Sunroof</option>
                  <option value="Panoramic Roof">Panoramic Roof</option>
                  <option value="Leather Seats">Leather Seats</option>
                  <option value="Heated Seats">Heated Seats</option>
                  <option value="Ventilated Seats">Ventilated Seats</option>
                  <option value="Sport Seats">Sport Seats</option>
                  <option value="Electric Seats">Electric Seats</option>
                  <option value="Keyless Entry">Keyless Entry</option>
                  <option value="Keyless Start">Keyless Start</option>
                  <option value="LED Headlights">LED Headlights</option>
                  <option value="Xenon Headlights">Xenon Headlights</option>
                  <option value="Fog Lights">Fog Lights</option>
                  <option value="Alloy Wheels">Alloy Wheels</option>
                  <option value="Sport Exhaust">Sport Exhaust</option>
                  <option value="Adaptive Cruise Control">Adaptive Cruise Control</option>
                  <option value="Lane Assist">Lane Assist</option>
                  <option value="Blind Spot Assist">Blind Spot Assist</option>
                  <option value="Traffic Sign Recognition">Traffic Sign Recognition</option>
                  <option value="Automatic Emergency Braking">Automatic Emergency Braking</option>
                  <option value="Android Auto">Android Auto</option>
                  <option value="Apple CarPlay">Apple CarPlay</option>
                  <option value="Premium Sound System">Premium Sound System</option>
                  <option value="Wireless Charger">Wireless Charger</option>
                  <option value="Tow Hitch">Tow Hitch</option>
                  <option value="Roof Rack">Roof Rack</option>
                  <option value="Tinted Windows">Tinted Windows</option>
                  <option value="Air Suspension">Air Suspension</option>
                  <option value="Sport Suspension">Sport Suspension</option>
                </select>
                <small style="color: var(--text-muted);">Hold Ctrl (Win) or Cmd (Mac) to select multiple.</small>
              </div>

              <button type="submit" class="btn-premium primary" style="width: 100%;">Publish Vehicle</button>
            </div>
          </form>
        </details>
      <% } %>

      <section class="vehicle-grid" id="vehicle-grid">
        <% if (Array.isArray(vehicles) && vehicles.length > 0) { %>
          <% vehicles.forEach(v => { %>
            <article class="vehicle-card">
              <% if (v.offers === "Yes") { %>
                <div class="offer-badge">OFFER</div>
              <% } %>

              <% if (user) { %>
                <button
                  class="fav-btn <%= (Array.isArray(favoriteIds) && favoriteIds.map(String).includes(String(v.id))) ? 'active' : '' %>"
                  type="button"
                  data-vehicle-id="<%= v.id %>"
                  aria-label="Toggle favourite"
                  title="Toggle favourite"
                >
                  <% if (Array.isArray(favoriteIds) && favoriteIds.map(String).includes(String(v.id))) { %>
                    <svg class="fav-icon" xmlns="http://www.w3.org/2000/svg" viewBox="0 0 24 24" aria-hidden="true">
                      <path d="M12 .587l3.668 7.568L24 9.748l-6 5.848L19.335 24 12 19.897 4.665 24 6 15.596 0 9.748l8.332-1.593z"/>
                    </svg>
                  <% } else { %>
                    <svg class="fav-icon" xmlns="http://www.w3.org/2000/svg" viewBox="0 0 24 24" aria-hidden="true">
                      <path d="M12 17.75l-6.172 3.245 1.18-6.875L2.01 9.255l6.902-1.003L12 2l3.088 6.252 6.902 1.003-4.998 4.865 1.18 6.875L12 17.75z"
                            fill="none" stroke="currentColor" stroke-width="1.8" stroke-linejoin="round"/>
                    </svg>
                  <% } %>
                </button>
              <% } %>

              <a href="/vehicles/<%= v.id %>" class="vehicle-link">
                <% const images = v.images || []; %>
                <% const mainImage = images.find(img => img.isMain) || images[0]; %>
                <% const mainSrc = mainImage ? mainImage.imageUrl : "https://darkorchid-chicken-425842.hostingersite.com/images/vehicles/defecto.png"; %>

                <div class="vehicle-main-image">
                  <img class="gallery-opener" src="<%= mainSrc %>" alt="<%= v.brand %> <%= v.model %>">
                </div>

                <div class="vehicle-info">
                  <h3><%= v.brand %> <%= v.model %></h3>
                  <p><%= v.vehicleType %></p>
                  <br>
                  <p>
                    <%= v.price %> € · <%= v.mileage %> miles
                    <% if (v.year) { %> · <%= v.year %><% } %>
                    <% if (v.fuelType || v.fuel_type) { %> · <%= v.fuelType || v.fuel_type %><% } %>
                  </p>
                </div>
              </a>
            </article>
          <% }) %>
        <% } else { %>
          <p class="empty-message">
            <%= (typeof isFavouritesPage !== 'undefined' && isFavouritesPage)
              ? 'No tienes vehículos en favoritos.'
              : 'No hay vehículos disponibles.' %>
          </p>
        <% } %>
      </section>

      <div class="pagination">
        <% if (currentPage > 1) { %>
          <a class="arrow page-link" href="/?page=<%= currentPage - 1 %><%= baseQuery ? '&' + baseQuery : '' %>">←</a>
        <% } else { %>
          <span class="arrow disabled">←</span>
        <% } %>

        <span class="current-page"><%= currentPage %></span>

        <% if (currentPage < totalPages) { %>
          <a class="arrow page-link" href="/?page=<%= currentPage + 1 %><%= baseQuery ? '&' + baseQuery : '' %>">→</a>
        <% } else { %>
          <span class="arrow disabled">→</span>
        <% } %>
      </div>

    </main>

    <footer class="home-footer">
      <p>DriveX is an creation of Los Del Fondo Devs. All rights reserved. Malaga, 2025.</p>
    </footer>

  </div>

  <div id="overlay"></div>

  <div id="contactMessage">
    <h2>Welcome to DriveX</h2>
    <p>Please, log in to access all the functions.</p>
    <a href="/login" class="btn-login-oculto">Log in</a>
    <button id="closeMessage">Close</button>
  </div>

  <script src="/js/header.js"></script>
  <script src="/js/main.js"></script>

</body>
</html>