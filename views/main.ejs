        <option value="Opel" <%= filters?.brand === "Opel" ? "selected" : "" %>>Opel</option>
        <option value="Peugeot" <%= filters?.brand === "Peugeot" ? "selected" : "" %>>Peugeot</option>
        <option value="Porsche" <%= filters?.brand === "Porsche" ? "selected" : "" %>>Porsche</option>
        <option value="Renault" <%= filters?.brand === "Renault" ? "selected" : "" %>>Renault</option>
        <option value="Seat" <%= filters?.brand === "Seat" ? "selected" : "" %>>Seat</option>
        <option value="Skoda" <%= filters?.brand === "Skoda" ? "selected" : "" %>>Skoda</option>
        <option value="Subaru" <%= filters?.brand === "Subaru" ? "selected" : "" %>>Subaru</option>
        <option value="Suzuki" <%= filters?.brand === "Suzuki" ? "selected" : "" %>>Suzuki</option>
        <option value="Tesla" <%= filters?.brand === "Tesla" ? "selected" : "" %>>Tesla</option>
        <option value="Toyota" <%= filters?.brand === "Toyota" ? "selected" : "" %>>Toyota</option>
