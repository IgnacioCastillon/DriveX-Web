<!DOCTYPE html>
<html lang="es">

<head>
  <meta charset="utf-8">
  <meta name="viewport" content="width=device-width, initial-scale=1.0">
  <title>DriveX · Catálogo</title>
  <link rel="icon" type="image/png" href="/images/logo.png">
  <link rel="stylesheet" href="/stylesheets/base.css">
  <link rel="stylesheet" href="/stylesheets/main.css">
  <link rel="stylesheet" href="/stylesheets/header.css">
</head>

<body class="home-body">
  <div class="home-wrapper">

    <!-- HEADER GLOBAL -->
    <%- include("partials/header", { 
      user, 
      activePage: "home", 
      showSearch: true,
      searchAction: "/",
      searchPlaceholder: "Search vehicles...",
      search
    }) %>

    <main class="home-main">
      <section class="hero-section">
        <div id="backgroundImageContainer">
          <img id="backgroundImage" src="/images/concesionario.jpg" alt="Background image">
          <div class="hero-overlay">
            <h1>Find Your Dream Vehicle</h1>
            <p>Explore our premium collection of cars, bikes, and more.</p>
            <nav class="hero-nav">
              <a href="/?vehicleType=Sedan,Suv,Hatchback,Off-road / 4x4,Van,MPV,Pickup,Sport Car,Hyper Car" class="active">Cars</a>
              <a href="/?vehicleType=Sport Bike,Custom,Naked,Enduro,Trial,MotoCross,Trail,Touring" class="active">Bikes</a>
              <a href="/?vehicleType=Truck" class="active">Trucks</a>
              <a href="/offers" class="offers">Offers</a>
            </nav>
          </div>
        </div>
      </section>

      <div class="section-header">
        <h2>
          <% if (search && search.trim() !== "") { %>
            Results for "<%= search %>"
          <% } else { %>
            Latest Arrivals
          <% } %>
        </h2>
      </div>
      
      <form id="dxFilters" class="dx-filters glass-panel" method="get" action="/" style="
  margin: 1rem 0 2rem;
  padding: 1rem;
  border-radius: var(--radius-xl);
  border: 1px solid rgba(255,255,255,.08);
  background: rgba(255,255,255,.02);
  display: grid;
  gap: 1rem;
">
  <input type="hidden" name="search" value="<%= search || '' %>">

