        <option value="Yamaha" <%= filters?.brand === "Yamaha" ? "selected" : "" %>>Yamaha</option>
      </select>
    </div>

    <div class="auth-field">
      <label>Type</label>
      <select name="vehicleType">
        <option value="">Any</option>
        <optgroup label="Cars">
          <option value="Sedan" <%= filters?.vehicleType === "Sedan" ? "selected" : "" %>>Sedan</option>
          <option value="Suv" <%= filters?.vehicleType === "Suv" ? "selected" : "" %>>Suv</option>
          <option value="Hatchback" <%= filters?.vehicleType === "Hatchback" ? "selected" : "" %>>Hatchback</option>
          <option value="Off-road / 4x4" <%= filters?.vehicleType === "Off-road / 4x4" ? "selected" : "" %>>Off-road / 4x4</option>
          <option value="Van" <%= filters?.vehicleType === "Van" ? "selected" : "" %>>Van</option>
          <option value="MPV / Minivan" <%= filters?.vehicleType === "MPV / Minivan" ? "selected" : "" %>>MPV / Minivan</option>
          <option value="Pickup" <%= filters?.vehicleType === "Pickup" ? "selected" : "" %>>Pickup</option>
          <option value="Sport Car" <%= filters?.vehicleType === "Sport Car" ? "selected" : "" %>>Sport Car</option>
          <option value="Hyper car" <%= filters?.vehicleType === "Hyper car" ? "selected" : "" %>>Hyper car</option>
        </optgroup>
        <optgroup label="Bikes">
          <option value="Sport Bike" <%= filters?.vehicleType === "Sport Bike" ? "selected" : "" %>>Sport Bike</option>
          <option value="Custom" <%= filters?.vehicleType === "Custom" ? "selected" : "" %>>Custom</option>
          <option value="Naked" <%= filters?.vehicleType === "Naked" ? "selected" : "" %>>Naked</option>
          <option value="Enduro" <%= filters?.vehicleType === "Enduro" ? "selected" : "" %>>Enduro</option>
          <option value="Trial" <%= filters?.vehicleType === "Trial" ? "selected" : "" %>>Trial</option>
          <option value="MotoCross" <%= filters?.vehicleType === "MotoCross" ? "selected" : "" %>>MotoCross</option>
