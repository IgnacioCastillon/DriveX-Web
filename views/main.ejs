        <option value="BMW" <%= filters?.brand === "BMW" ? "selected" : "" %>>BMW</option>
        <option value="Bugatti" <%= filters?.brand === "Bugatti" ? "selected" : "" %>>Bugatti</option>
        <option value="Cadillac" <%= filters?.brand === "Cadillac" ? "selected" : "" %>>Cadillac</option>
        <option value="Chevrolet" <%= filters?.brand === "Chevrolet" ? "selected" : "" %>>Chevrolet</option>
        <option value="Citroen" <%= filters?.brand === "Citroen" ? "selected" : "" %>>Citroen</option>
        <option value="Cupra" <%= filters?.brand === "Cupra" ? "selected" : "" %>>Cupra</option>
